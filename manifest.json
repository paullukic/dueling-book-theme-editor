{
  "manifest_version": 3,
  "name": "DuelingBook Theme Editor - Dark Themes, Hotkeys & Duel Tools",
  "short_name": "DB Theme Editor",
  "version": "1.2.0",
  "description": "Sleek dark themes for every screen, hotkeys, turn alerts, test hands and chat mute for duelingbook.com. No data collected.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://duelingbook.com/*",
    "http://duelingbook.com/*",
    "https://www.duelingbook.com/*",
    "http://www.duelingbook.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://duelingbook.com/*",
        "http://duelingbook.com/*",
        "https://www.duelingbook.com/*",
        "http://www.duelingbook.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://duelingbook.com/*",
        "http://duelingbook.com/*",
        "https://www.duelingbook.com/*",
        "http://www.duelingbook.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "https://duelingbook.com/*",
        "http://duelingbook.com/*",
        "https://www.duelingbook.com/*",
        "http://www.duelingbook.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open DuelingBook Theme Editor",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open or close the Theme Editor panel"
    }
  }
}
